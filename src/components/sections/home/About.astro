---
// components
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import Container from "../../elements/Container.astro";
import Link from "../../elements/Link.astro";
import ImageContainer from "../../elements/ImageContainer.astro";

// assets
import peter2 from "../../../assets/images/peter2.jpg";
---

<Container variant={'xl'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">About</Heading>
    <div class="flex lg:flex-row lg:gap-16 gap-10 flex-col">
        <div class="flex flex-col items-start gap-6 lg:pt-6 text-base-900 lg:flex-1">
            <Text variant={'xl'} class="text-white font-bold">
            I’m a results-driven Project Management professional who thrives at the intersection of operational efficiency and data analysis.
          </Text>
          <Text variant={'sm'} class="text-white/80">
            With extensive experience in multinational environments like HP Inc. and HPE, I specialize in managing complex service delivery workflows and ensuring 95% SLA compliance.
          </Text>
          <Text variant={'sm'} class="text-white/80">
            I leverage tools like Power BI, SQL, and Python to bridge the gap between operational challenges and scalable, data-driven solutions.
          </Text>
          <Link variant={'button'} href="/about">READ MORE ABOUT MY EXPERIENCE</Link>