---
import Layout from '../layouts/Layout.astro';
import Container from '../components/elements/Container.astro';
import Heading from '../components/elements/Heading.astro';
import Text from '../components/elements/Text.astro';
---

<Layout title="About | Daniel Rojas">
  <Container variant={'xl'} class="mt-20">
    <Heading tagName="h1" tagSize="h1">About Me</Heading>
    <div class="mt-10 max-w-3xl">
  <Text class="mb-5 text-white text-xl leading-relaxed">
    I am a Project and Operations professional with experience in multinational environments such as **HP Inc.** and **Hewlett Packard Enterprise**.
  </Text>
  
  <Text class="mb-5 text-white text-lg">
    My expertise includes coordinating high-volume initiatives, managing SLA compliance, and driving operational efficiency through data analysis with **Power BI**, **SQL**, and **Python**.
  </Text>
</div>
  </Container>
</Layout>